# Copy to .env and fill in. .env is gitignored - never commit it.

VERIFIX_ENV=dev

# Postgres from docker-compose.yml (host port 5434 so it never clashes with eap or rag-curriculum)
VERIFIX_DATABASE_URL=postgresql+asyncpg://verifix:verifix_dev@localhost:5434/verifix
# Used only by the test suite; created automatically by docker/postgres-init.sql
VERIFIX_TEST_DATABASE_URL=postgresql+asyncpg://verifix:verifix_dev@localhost:5434/verifix_test

# Anthropic. Either name works; VERIFIX_ANTHROPIC_API_KEY wins if both are set.
ANTHROPIC_API_KEY=
VERIFIX_MODEL_MAIN=claude-sonnet-5-5
VERIFIX_MODEL_FAST=claude-haiku-5-5
VERIFIX_LLM_TIMEOUT_S=120
VERIFIX_LLM_MAX_ATTEMPTS=4

VERIFIX_LOG_LEVEL=INFO
VERIFIX_LOG_JSON=false

# Comma-separated origins allowed to call the API (the Vite dev server by default)
VERIFIX_CORS_ORIGINS=http://localhost:5173
